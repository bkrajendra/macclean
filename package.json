{
	"name": "macclean",
	"version": "1.0.5",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "MacClean — a native macOS cleanup utility (Svelte 5 + Tauri 2 + Rust)",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"icons": "node scripts/gen-icons.mjs",
		"tauri": "tauri",
		"clean": "rm -rf build .svelte-kit .eslintcache dist-artifacts RELEASE_NOTES.md src-tauri/gen/schemas src-tauri/target; cargo clean --manifest-path src-tauri/Cargo.toml 2>/dev/null || true",
		"clean:all": "npm run clean && rm -rf node_modules"
	},
	"dependencies": {
		"@lucide/svelte": "^1.37.0",
		"@tauri-apps/api": "^2.1.1",
		"@tauri-apps/plugin-opener": "^2.2.5"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.15.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tauri-apps/cli": "^2.2.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.2.6",
		"@testing-library/user-event": "^14.5.2",
		"autoprefixer": "^10.4.20",
		"clsx": "^2.1.1",
		"jsdom": "^30.0.1",
		"postcss": "^8.4.49",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.16.0",
		"svelte-check": "^4.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
