{
	"name": "macclean",
	"version": "1.3.0",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "MacClean — a native macOS cleanup utility (Svelte 5 + Tauri 2 + Rust)",
	"scripts": {
		"prepare": "node scripts/install-git-hooks.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"icons": "node scripts/gen-icons.mjs",
		"tauri": "tauri",
		"clean": "rm -rf build .svelte-kit .eslintcache dist-artifacts RELEASE_NOTES.md src-tauri/gen/schemas src-tauri/target; cargo clean --manifest-path src-tauri/Cargo.toml 2>/dev/null || true",
		"clean:all": "npm run clean && rm -rf node_modules"
	},
	"dependencies": {
		"@lucide/svelte": "^1.48.0",
		"@tauri-apps/api": "^2.1.1",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.13.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.15.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tauri-apps/cli": "^2.11.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.2.6",
		"@testing-library/user-event": "^14.6.7",
		"autoprefixer": "^10.6.1",
		"clsx": "^2.1.1",
		"jsdom": "^30.1.1",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.1.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
