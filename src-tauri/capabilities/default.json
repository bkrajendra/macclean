{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities for the MacClean main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:event:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch",
    "process:allow-exit",
    "process:allow-restart",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "log:default"
  ]
}
